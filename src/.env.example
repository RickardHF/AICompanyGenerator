# OpenAI API Configuration
# IMPORTANT: These should NOT have the NEXT_PUBLIC_ prefix as they are server-side only
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_openai_organization_id_here

# Optional: Affiliate link (can be public as it's non-sensitive)
NEXT_PUBLIC_NAMECHEAP_AFFILIATE_LINK=https://namecheap.com/
